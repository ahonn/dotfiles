config/fish/fishd.*
vim/plugged/
vim/sessions/
config/fish/fish_variables
config/fish/proxy.fish
config/fish/secret.fish
config/nvim/plugin
.vimworkspace
.undodir
result
docs/

# Codex-managed system skills (auto-installed at runtime, not source)
.claude/skills/.system/

# Codex live config: continuously rewritten by Codex (machine-specific paths,
# local project trust state). Symlinked from the repo but not versioned.
.codex/config.toml

# Bytecode from skill helper scripts (.claude/skills/**/scripts/*.py)
__pycache__/

# Paseo-managed skills: rewritten by the paseo daemon at runtime, not source
.claude/skills/paseo/
.claude/skills/paseo-*/

# Synced skills: written by Claude at runtime (docx, pdf, pptx, ...), not source
.claude/skills/synced/

# Superseded synced skills: moved here by Claude at runtime, not source
.claude/skills/.trash/

# Tool-managed skills: written by Orca, Pinky, and Moshi at runtime, not source.
# orchestration is a symlink into ~/.agents/skills, so its pattern has no slash.
.claude/skills/orchestration
.claude/skills/pinky/
.claude/skills/moshi-visuals/

# Installer backups of live configs: can hold credentials (.codex/config.toml.bak)
*.bak
